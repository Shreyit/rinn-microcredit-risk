% rinn-report.sty: house style for the Rinn written report
% A4, 11pt, Latin Modern, author-year citations, British English
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{rinn-report}[2026/10/21 Rinn report style]

% ---------- fonts & language ----------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern}
\RequirePackage[british]{babel}
\RequirePackage{microtype}

% ---------- page geometry & spacing ----------
\RequirePackage[a4paper,top=2.5cm,bottom=2.5cm,left=2.5cm,right=2.5cm,headheight=14pt]{geometry}
\RequirePackage{setspace}
\setstretch{1.15}
\RequirePackage{parskip}

% ---------- maths ----------
\RequirePackage{amsmath,amssymb,mathtools,bm}
\numberwithin{equation}{section}
\newcommand{\vect}[1]{\bm{#1}}
\newcommand{\R}{\mathbb{R}}
\newcommand{\sigmoid}{\sigma}
\DeclareMathOperator{\sign}{sign}
\DeclareMathOperator*{\argmax}{arg\,max}
\DeclareMathOperator*{\argmin}{arg\,min}

% ---------- tables, figures, colour ----------
\RequirePackage{booktabs,tabularx,array,float}
\RequirePackage{graphicx}
\RequirePackage[table]{xcolor}
\RequirePackage[font=small,labelfont=bf,labelsep=period]{caption}
\definecolor{rinnblue}{HTML}{1E3A5F}
\definecolor{rinngrey}{HTML}{5B6573}
\definecolor{rinnlight}{HTML}{F2F4F7}
\definecolor{rinnaccent}{HTML}{B45309}

% ---------- references ----------
\RequirePackage[authoryear,round]{natbib}
\bibliographystyle{plainnat}

% ---------- links ----------
\RequirePackage[hidelinks,pdfusetitle,bookmarksnumbered]{hyperref}

% ---------- sectioning (no titlesec needed) ----------
\makeatletter
\renewcommand\section{\@startsection{section}{1}{\z@}%
  {-3ex \@plus -1ex \@minus -.2ex}{1.6ex \@plus .2ex}%
  {\normalfont\Large\bfseries\color{rinnblue}}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
  {-2.5ex \@plus -1ex \@minus -.2ex}{1ex \@plus .2ex}%
  {\normalfont\large\bfseries\color{rinnblue}}}
\renewcommand\subsubsection{\@startsection{subsubsection}{3}{\z@}%
  {-2ex \@plus -.5ex \@minus -.2ex}{.6ex}%
  {\normalfont\normalsize\bfseries}}
\makeatother

% ---------- headers & footers: "Page x of y" without lastpage ----------
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\fancyhead[L]{\small\color{rinngrey}\CourseShort}
\fancyhead[R]{\small\color{rinngrey}\RollNo\ \textbar\ Version ID \VersionID}
\fancyfoot[C]{\small Page \thepage\ of \pageref{rinn@lastpage}}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[C]{\small Page \thepage\ of \pageref{rinn@lastpage}}}
\makeatletter
\AtEndDocument{\clearpage\immediate\write\@auxout{%
  \string\newlabel{rinn@lastpage}{{}{\the\numexpr\value{page}-1\relax}{}{}{}}}}
\makeatother

% ---------- metadata (set in metadata.tex) ----------
\newcommand*{\StudentName}{}\newcommand*{\RollNo}{}\newcommand*{\VersionID}{}
\newcommand*{\CourseShort}{}\newcommand*{\CourseLong}{}\newcommand*{\Institution}{}
\newcommand*{\School}{}\newcommand*{\Programme}{}\newcommand*{\Instructor}{}
\newcommand*{\SubmissionDate}{}\newcommand*{\SectionIChoice}{}
\newcommand{\AIDeclaration}{}

% ---------- question / answer blocks ----------
% \question{1.1}{2 marks}{Question text}  → shaded restatement with marks
\newcommand{\question}[3]{%
  \par\medskip\noindent
  \colorbox{rinnlight}{\parbox{\dimexpr\linewidth-2\fboxsep\relax}{%
    \small\textbf{#1}\hfill\textcolor{rinngrey}{[#2]}\\[2pt]
    \itshape #3}}\par\smallskip}

% \answerhead{300} → word-limit note for a whole question
\newcommand{\wordlimit}[1]{\textcolor{rinngrey}{\small\itshape Word limit: $\leq #1$ words (equations and tables excluded).}\par}

% placeholder for unfinished parts. The build script refuses to package a PDF containing it
\newcommand{\pending}[1][Answer to be written.]{%
  \par\noindent\fcolorbox{rinnaccent}{white}{\parbox{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}{%
    \small\color{rinnaccent}\textbf{PENDING:} #1}}\par}

% final-answer highlight
\newcommand{\finalans}[1]{\boxed{#1}}

\endinput
